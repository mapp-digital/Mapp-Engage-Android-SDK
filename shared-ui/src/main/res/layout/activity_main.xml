<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    tools:ignore="HardcodedText">

    <Switch
        android:id="@+id/switchReady"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        android:text="Is Ready"
        tools:ignore="HardcodedText,UseSwitchCompatOrMaterialXml" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:layout_marginVertical="10dp"
                android:hint="New alias"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusTopStart="15dp"
                app:placeholderText="Enter alias">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextAlias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetAlias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Set Alias" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGetAlias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Get Alias" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGetDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Get Device" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFetchInboxMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fetch Inbox Messages" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFetchInappMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fetch InApp Messages" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestCallExecute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Test call (execute)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestCallEnqueue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Test call (enqueue)" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>