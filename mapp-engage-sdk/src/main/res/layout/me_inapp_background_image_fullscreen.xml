<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginVertical="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone"
        tools:alpha="0.5"
        tools:src="@drawable/me_nat"
        tools:visibility="visible" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/ibClose"
        android:layout_alignParentTop="true"
        android:paddingHorizontal="5dp"
        android:paddingVertical="10dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextAppearance.AppCompat.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="5dp"
                android:paddingVertical="10dp"
                android:textAlignment="center"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                tools:maxLength="20"
                tools:text="@tools:sample/lorem/random"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvContent"
                style="@style/TextAppearance.AppCompat.Subhead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_horizontal|top"
                android:paddingHorizontal="5dp"
                android:paddingVertical="10dp"
                android:textAlignment="center"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                tools:maxLength="4000"
                tools:text="@tools:sample/lorem/random"
                tools:visibility="visible" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/llBottomBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:layout_marginHorizontal="10dp"
        android:paddingVertical="10dp">

        <Button
            android:id="@+id/btn1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.4"
            android:background="@drawable/me_round_rect_button"
            android:visibility="gone"
            tools:backgroundTint="@android:color/holo_red_dark"
            tools:text="button 1"
            tools:textColor="@android:color/white"
            tools:visibility="visible" />

        <Space
            android:id="@+id/spacer"
            android:layout_width="0dp"
            android:layout_weight="0.06"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.4"
            android:background="@drawable/me_round_rect_button"
            android:visibility="gone"
            tools:backgroundTint="@android:color/holo_red_dark"
            tools:text="button 2"
            tools:textColor="@android:color/white"
            tools:visibility="visible" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/ibClose"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:contentDescription="@android:string/cancel"
        android:padding="0dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel" />
</RelativeLayout>
